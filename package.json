    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "exifr": "^7.1.3",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "lxgw-wenkai-webfont": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
