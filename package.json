{
  "name": "memory-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:viewer",
    "build:viewer": "vite build --config vite.viewer.config.ts --logLevel warn",
    "build": "tsc --noEmit && npm run build:viewer && vite build",
